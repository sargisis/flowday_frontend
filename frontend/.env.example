# ==========================
# Flowday Frontend Configuration
# ==========================
# Copy this file to .env and update values for your environment

# API Configuration
# -----------------
# Full API base URL (overrides auto-detection)
# Leave empty for auto-detection based on hostname
VITE_API_BASE_URL=

# Backend API port (used for auto-detection on localhost and mobile)
# Default: 8080
VITE_API_PORT=8080

# File upload base URL (for avatars, attachments)
# Leave empty to use same host:port as API
VITE_FILE_UPLOAD_BASE_URL=

# App Configuration
# ------------------
VITE_APP_NAME=Flowday
VITE_APP_VERSION=1.0.0
VITE_ENV=development

# ==========================
# Example configurations:
# ==========================

# Local Development (default)
# ----------------------------
# VITE_API_PORT=8080
# (no need to set VITE_API_BASE_URL)

# Mobile Testing (access from phone on same network)
# ---------------------------------------------------
# Leave VITE_API_BASE_URL empty - will auto-detect your computer's IP
# VITE_API_PORT=8080

# Staging Environment
# -------------------
# VITE_API_BASE_URL=https://staging-api.flowday.com/api/v1
# VITE_FILE_UPLOAD_BASE_URL=https://staging-cdn.flowday.com

# Production Environment
# ----------------------
# VITE_API_BASE_URL=https://api.flowday.com/api/v1
# VITE_FILE_UPLOAD_BASE_URL=https://cdn.flowday.com
